			"children": [
				{
					"eventType": "block",
					"conditions": [
						{
							"id": "compare-eventvar",
							"objectClass": "System",
							"sid": 426924592951028,
							"parameters": {
								"variable": "CurrentWave",
								"comparison": 2,
								"value": "GameData.ArraySize(\"waves\")"
							}
						}
					],
					"actions": [
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const runData = runtime.objects.RunData.getFirstInstance();",
								"const shopManager = runtime.objects.ShopManager.getFirstInstance();",
								"",
								"// Ключи в RunData, соответствующие индексам спутников",
								"const companionKeys = [",
								"    \"zhuzhik\",",
								"    \"zaika\",",
								"    \"tomato\"",
								"];",
								"",
								"// Получаем хранилище Dictionary",
								"const data = runData.getDataMap();",
								"",
								"// Формируем список доступных индексов",
								"const availableIndexes = [];",
								"",
								"for (let i = 0; i < companionKeys.length; i++) {",
								"    const key = companionKeys[i];",
								"",
								"    if (data.get(key) === 0) {",
								"        availableIndexes.push(i);",
								"    }",
								"}",
								"",
								"// Если свободных спутников нет",
								"if (availableIndexes.length === 0) {",
								"    shopManager.instVars.CompanionIndex = -1;",
								"    console.log(\"No available companions\");",
								"} else {",
								"    // Выбираем случайный доступный индекс",
								"    const randomPosition = Math.floor(",
								"        Math.random() * availableIndexes.length",
								"    );",
								"",
								"    const selectedIndex = availableIndexes[randomPosition];",
								"",
								"    // Записываем результат в ShopManager",
								"    shopManager.instVars.CompanionIndex = selectedIndex;",
								"",
								"    console.log(\"Selected companion:\", selectedIndex);",
								"}"
							]
						},
